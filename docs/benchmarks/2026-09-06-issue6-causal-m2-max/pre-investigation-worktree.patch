+
+        module.experts = experts
+        mx.eval(module(mx.ones((1, 1, 2), dtype=mx.bfloat16)))
+        expected = np.argsort(np.array(logits.astype(mx.float32)).reshape(-1))[-3:]
+        self.assertEqual(set(selected), set(expected.tolist()))
