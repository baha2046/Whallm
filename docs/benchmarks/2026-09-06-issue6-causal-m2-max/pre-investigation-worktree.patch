+class QwenGatedDeltaNet(MLXGatedDeltaNet):
+    """Qwen4 FP32 L2 normalization and recurrent math, with the MLX kernel.
+
+    Forward adapted from mlx-lm qwen3_5 (Copyright 2026 Apple Inc., MIT).
+    The reference uses sum(x*x) + eps, not mean(x*x) + eps; substituting
+    RMSNorm with the same epsilon changes small query/key vectors materially.
+    """
