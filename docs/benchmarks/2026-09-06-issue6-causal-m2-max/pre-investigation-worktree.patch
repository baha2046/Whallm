+        args = ModelArgs(hidden_size=8, linear_num_value_heads=1, linear_num_key_heads=1,
+                         linear_key_head_dim=128, linear_value_head_dim=4)
+        model = QwenGatedDeltaNet(args)
+        model.load_weights([(k, v.astype(mx.bfloat16)) for k, v in tree_flatten(model.parameters())])
+        model.norm = RMSNormGated(4, 1e-6)
+        model.norm.weight = mx.ones((4,), dtype=mx.bfloat16)
+        model.eval()
+        inputs = mx.random.normal((1, 3, 8)).astype(mx.bfloat16)
+        full_cache, step_cache = ArraysCache(size=2), ArraysCache(size=2)
+        full = model(inputs, cache=full_cache)
+        steps = mx.concatenate([model(inputs[:, i:i+1], cache=step_cache) for i in range(3)], axis=1)
+        self.assertEqual(full.dtype, mx.bfloat16)
+        self.assertEqual(full_cache[1].dtype, mx.float32)
+        np.testing.assert_allclose(np.array(full.astype(mx.float32)), np.array(steps.astype(mx.float32)), atol=0.002, rtol=0.02)
