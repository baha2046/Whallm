+    def test_delta_l2norm_uses_sum_epsilon_in_float32_for_small_keys(self):
+        values = mx.full((1, 2, 1, 128), 0.0001, dtype=mx.bfloat16)
+        raw = np.array(values.astype(mx.float32))
+        expected = raw / np.sqrt(np.square(raw).sum(axis=-1, keepdims=True) + 1e-6)
+        actual = _qwen_l2norm(values)
+        self.assertEqual(actual.dtype, mx.float32)
+        np.testing.assert_allclose(np.array(actual), expected, rtol=1e-6, atol=1e-7)
