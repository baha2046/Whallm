     min_p: float = 0.0
     presence_penalty: float = 0.0
     repetition_penalty: float = 1.0
+    frequency_penalty: float = 0.0
+    no_repeat_ngram_size: int = 0
     approximation_mode: str = EXACT_APPROXIMATION_MODE
 
 
+def _generation_logits_processors(options: GenerationOptions, *, is_qwen: bool):
+    settings = {}
+    for name, neutral in (("presence", 0), ("repetition", 1), ("frequency", 0)):
+        penalty = getattr(options, f"{name}_penalty")
+        if penalty != neutral:
+            settings[f"{name}_penalty"] = penalty
+            if is_qwen:
+                # mlx-lm uses tokens[-context_size:]; zero means all history.
+                settings[f"{name}_context_size"] = 0
+    processors = make_logits_processors(**settings) if settings else []
+    if not is_qwen:
+        return processors
+    # Both pinned mlx-lm generate_step and Qwen MTP supply the final prompt
+    # token followed by generated tokens. Exclude that prompt anchor. Keeping
+    # this stateless also makes MTP speculative branches/rollback independent.
+    generated_processors = [
+        lambda tokens, logits, processor=processor: processor(tokens[1:], logits)
+        for processor in processors
+    ]
+    if options.no_repeat_ngram_size:
+        generated_processors.append(_no_repeat_generated_ngram(options.no_repeat_ngram_size))
+    return generated_processors
+
+
+def _no_repeat_generated_ngram(size: int):
+    """Block an already generated token sequence, without CPU sync or mutable state."""
+    if isinstance(size, bool) or not isinstance(size, int) or not 1 <= size <= 256:
+        raise ValueError("no_repeat_ngram_size must be between 1 and 256")
+
+    def process(tokens, logits):
+        generated = tokens[1:]
+        if len(generated) < size:
+            return logits
+        if size == 1:
+            return logits.at[:, generated].add(-float("inf"))
+        # Compare every prior (size - 1)-token prefix with the current suffix.
+        # Strides are in elements, and this overlapping view never crosses the
+        # source array. Each matching continuation would repeat a full n-gram.
+        prefixes = mx.as_strided(
+            generated,
+            shape=(len(generated) - size + 1, size - 1),
+            strides=(1, 1),
+        )
+        matches = mx.all(prefixes == generated[-(size - 1):], axis=1)
+        adjustment = mx.where(matches, -float("inf"), 0).astype(logits.dtype)
+        return logits.at[:, generated[size - 1:]].add(adjustment)
+
+    return process
+
