+def _generation_logits_processors(options: GenerationOptions, *, is_qwen: bool):
+    settings = {}
+    for name, neutral in (("presence", 0), ("repetition", 1), ("frequency", 0)):
+        penalty = getattr(options, f"{name}_penalty")
+        if penalty != neutral:
+            settings[f"{name}_penalty"] = penalty
+            if is_qwen:
+                # mlx-lm uses tokens[-context_size:]; zero means all history.
+                settings[f"{name}_context_size"] = 0
+    processors = make_logits_processors(**settings) if settings else []
+    if not is_qwen:
+        return processors
+    # Both pinned mlx-lm generate_step and Qwen MTP supply the final prompt
+    # token followed by generated tokens. Exclude that prompt anchor. Keeping
+    # this stateless also makes MTP speculative branches/rollback independent.
+    return [
+        lambda tokens, logits, processor=processor: processor(tokens[1:], logits)
+        for processor in processors
+    ]
+
